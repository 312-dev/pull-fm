# ---------------------------------------------------------------------------
# Pull.fm - local development environment template
#
# Copy to `.env` (gitignored) or, preferred, drive it from 1Password via direnv
# so secrets never touch disk:
#
#   export WORKOS_API_KEY="$(op read 'op://MCP/Pull.fm WorkOS Staging API Key/credential')"
#
# NOTHING in this file is a real credential. The repo is public and gitleaks
# blocks any commit containing one.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
DEPLOY_ENV=local          # local | staging | production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info            # fatal | error | warn | info | debug | trace

# --- Data stores -----------------------------------------------------------
# Matches docker-compose.dev.yml. Local-only throwaway credential.
DATABASE_URL=postgres://pullfm:pullfm_local_dev_not_a_secret@localhost:5432/pullfm
REDIS_URL=redis://localhost:6379

# Quota and rate-limit counters. A SEPARATE instance running `noeviction`, not a
# second database on the cache instance: eviction policy in Redis is per-instance,
# and on a shared allkeys-lru instance a cache-fill event evicts the counters and
# every rate limit fails open with no error and no alert.
REDIS_QUOTA_URL=redis://localhost:6380

# Kept small on purpose: concurrency is absorbed by PgBouncer, and every BFF
# node multiplies into the server's max_connections.
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000

# --- Credential vault (envelope encryption) --------------------------------
# Comma-separated id=base64key pairs. Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Multiple keys may be present at once so rotation is non-breaking: existing
# rows stay readable under the key that sealed them while new writes use the
# active key. NEVER drop a key that still has rows; that is unrecoverable.
CREDENTIAL_KEKS=kek:v1=REPLACE_ME_WITH_A_GENERATED_32_BYTE_BASE64_KEY
CREDENTIAL_ACTIVE_KEK_ID=kek:v1

# --- Identity (WorkOS Magic Auth) ------------------------------------------
# Sign-in is MAGIC LINK ONLY: no password, no social login, no passkeys.
# authenticateWithMagicAuth is a server-to-server call, so every login screen is
# ours and the user never sees a hosted page or a third-party hostname. Social
# login would need a hosted redirect plus a 99 USD/month custom domain to keep
# that property, and passkeys would bind credentials to a domain we have not
# committed to. Both are deferred deliberately; read the reasoning at the top of
# apps/bff/src/routes/v1/auth.ts before adding either, and note that migration
# 0005 CHECK-constrains users.auth_method so widening it is a reviewed change.
#
# The client id is a PUBLIC identifier shipped to clients, not a secret.
WORKOS_CLIENT_ID=client_01KYMZ05X60BJKZKY5RTA5YP8B
# Secret. Resolve at runtime:
#   op://MCP/Pull.fm WorkOS Staging API Key/credential
WORKOS_API_KEY=sk_test_REPLACE_ME

# Signing secret for POST /v1/webhooks/workos. REQUIRED whenever NODE_ENV is
# production (which includes staging): that route handles user.deleted, which
# cascades through the credential vault, so without verification it is an
# unauthenticated mass-deletion endpoint. Absent, the route answers 503 and
# processes nothing; in production the process refuses to start at all.
#   op://MCP/Pull.fm WorkOS Webhook Secret/credential
WORKOS_WEBHOOK_SECRET=

# Test-only override of the identity endpoints, so the security suites can mint
# tokens against a JWKS they control. IGNORED in production, where both are
# derived from WORKOS_CLIENT_ID and a non-WorkOS host is a startup failure.
# See security/BOLA-TESTING.md section 3.
# WORKOS_JWKS_URL=
# WORKOS_API_BASE_URL=https://api.workos.com

# --- Magic-link abuse budgets ----------------------------------------------
# Counted in the noeviction quota Redis above, per window, and they fail CLOSED.
# On POST /v1/auth/start a limiter that fails open is not a missing control, it
# is an open mail relay pointed at arbitrary third parties.
#
# Two send dimensions, because neither subsumes the other: PER_IP stops one host
# enumerating many addresses, PER_EMAIL stops many hosts flooding one mailbox.
# The verify budget is tighter because a short code is guessable at volume.
AUTH_MAGIC_AUTH_PER_IP_MAX=10
AUTH_MAGIC_AUTH_PER_EMAIL_MAX=5
AUTH_MAGIC_AUTH_VERIFY_MAX=10
AUTH_MAGIC_AUTH_WINDOW_S=3600

# Floor, in milliseconds, on how long POST /v1/auth/start takes to answer. The
# response body is identical for a registered and an unregistered address; this
# stops the CLOCK from disclosing what the body will not. Not constant time and
# not claimed to be; see apps/bff/src/services/magic-auth.ts.
AUTH_START_FLOOR_MS=250

# --- Session cookie --------------------------------------------------------
# Browser clients receive their session as an AES-256-GCM sealed, HttpOnly,
# SameSite=Strict cookie instead of tokens in a response body, because a refresh
# token JavaScript can read is a permanent account takeover one XSS away. Mobile
# clients ask for `transport: "bearer"` and get tokens in the body as before.
#
# There is NO key to configure. The sealing key is derived from the active KEK
# with HKDF under its own label at startup (apps/bff/src/lib/session-cookie.ts),
# so there is no additional secret to escrow and none is ever at rest. Rotating
# the KEK signs everyone out, which is a re-sign-in, not a failed rotation.
#
# The cookie NAME is derived rather than configured: `__Host-pullfm_session`
# wherever the deployment is reached over TLS, because that browser-enforced
# prefix is what stops a sibling host shadowing the cookie, and the unprefixed
# name on plain-HTTP local development where the prefix is not usable.
SESSION_COOKIE_TTL_S=2592000

# --- Upstream providers ----------------------------------------------------
# MusicBrainz REQUIRES a descriptive User-Agent naming the app and a contact.
# This is a licence condition and the app refuses to start without it.
MUSICBRAINZ_USER_AGENT=PullFM/0.1.0 (ope@312.dev)

# Last.fm: key and shared secret are GLOBAL (app-owned). Each user's session
# key is per-user and lives encrypted in the vault, never here.
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=

# Last.fm ToS 4.3.4 caps cached Last.fm data at 100 MB. Alert below the cap so
# eviction has room to act before we are out of compliance.
LASTFM_CACHE_CAP_MB=80

# ListenBrainz has no application-level key at all: it is purely per-user
# tokens, supplied by each user at connect time and stored in the vault.

# iTunes, Deezer, ReccoBeats, and AcousticBrainz are keyless.

# --- Live events (SeatGeek) ------------------------------------------------
# Absent client id disables GET /v1/artists/:mbid/events outright: the route
# answers 501, which is a stable "this deployment has no events provider"
# rather than an empty list that reads as "this artist is not touring".
#
# The client id is 35 characters and lives in the NOTES field of the 1Password
# item; the 64-character secret is the item's password. Only the secret is a
# credential, but both are kept out of URLs and logs - the client prefers HTTP
# Basic precisely so neither ends up in an access log or an error string.
#   op://MCP/Pull FM Seat Geek API Key
SEATGEEK_CLIENT_ID=
SEATGEEK_CLIENT_SECRET=

# Runtime kill switch, separate from the credential being absent. This is the
# lever to pull the hour SeatGeek write to say our use breaches their terms;
# "stop now" is a legal obligation measured in hours, not deploy cycles.
SEATGEEK_ENABLED=true

# --- Personal API tokens ---------------------------------------------------
# Read-only credentials a user creates for scripted access to their own data.
# Only a SHA-256 digest is stored; the prefix (pfm_live_ / pfm_test_) follows
# DEPLOY_ENV so a leaked token is identifiable by shape. See
# docs/api/personal-api-tokens.md.
API_TOKEN_MAX_PER_USER=10
API_TOKEN_DEFAULT_TTL_DAYS=90
API_TOKEN_MAX_TTL_DAYS=365
# Per-token requests per minute, counted in the noeviction quota Redis so a
# cache-fill event cannot silently disable it (THREAT-MODEL T11).
API_TOKEN_DEFAULT_RATE_LIMIT=60

# --- Account lifecycle -----------------------------------------------------
# DELETE /v1/me is irreversible, so it requires a recently issued session
# rather than merely a valid one (THREAT-MODEL M16).
DELETE_FRESH_AUTH_MAX_AGE_S=900
# GET /v1/me/export issues a single-use download link; the cooldown stops the
# route from becoming an authenticated self-service denial of service.
EXPORT_COOLDOWN_S=300
EXPORT_LINK_TTL_S=600

# --- HTTP ------------------------------------------------------------------
# Public origin this API is reached at. Used to build the connect-flow callback
# and the export download link, both of which are compared for exact equality
# on the way back in.
PUBLIC_BASE_URL=http://127.0.0.1:3000

# Serves the self-hosted OpenAPI reference browser at /docs. No CDN: the bundle
# ships in the package and the CSP forbids external hosts.
DOCS_ENABLED=true

# Global per-IP floor. Personal API tokens carry their own per-token budget.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# Comma-separated exact origins. A wildcard is rejected outside local dev,
# because this API serves per-user data with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Serves 503 with Retry-After on every route except health checks.
MAINTENANCE_MODE=false
