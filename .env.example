# ---------------------------------------------------------------------------
# Pull.fm - local development environment template
#
# Copy to `.env` (gitignored) or, preferred, drive it from 1Password via direnv
# so secrets never touch disk:
#
#   export WORKOS_API_KEY="$(op read 'op://MCP/Pull.fm WorkOS Staging API Key/credential')"
#
# NOTHING in this file is a real credential. The repo is public and gitleaks
# blocks any commit containing one.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
DEPLOY_ENV=local          # local | staging | production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info            # fatal | error | warn | info | debug | trace

# --- Data stores -----------------------------------------------------------
# Matches docker-compose.dev.yml. Local-only throwaway credential.
DATABASE_URL=postgres://pullfm:pullfm_local_dev_not_a_secret@localhost:5432/pullfm
REDIS_URL=redis://localhost:6379

# Kept small on purpose: concurrency is absorbed by PgBouncer, and every BFF
# node multiplies into the server's max_connections.
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000

# --- Credential vault (envelope encryption) --------------------------------
# Comma-separated id=base64key pairs. Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Multiple keys may be present at once so rotation is non-breaking: existing
# rows stay readable under the key that sealed them while new writes use the
# active key. NEVER drop a key that still has rows; that is unrecoverable.
CREDENTIAL_KEKS=kek:v1=REPLACE_ME_WITH_A_GENERATED_32_BYTE_BASE64_KEY
CREDENTIAL_ACTIVE_KEK_ID=kek:v1

# --- Identity (WorkOS AuthKit) ---------------------------------------------
# The client id is a PUBLIC identifier shipped to clients, not a secret.
WORKOS_CLIENT_ID=client_01KYMZ05X60BJKZKY5RTA5YP8B
# Secret. Resolve at runtime:
#   op://MCP/Pull.fm WorkOS Staging API Key/credential
WORKOS_API_KEY=sk_test_REPLACE_ME

# --- Upstream providers ----------------------------------------------------
# MusicBrainz REQUIRES a descriptive User-Agent naming the app and a contact.
# This is a licence condition and the app refuses to start without it.
MUSICBRAINZ_USER_AGENT=PullFM/0.1.0 (ope@312.dev)

# Last.fm: key and shared secret are GLOBAL (app-owned). Each user's session
# key is per-user and lives encrypted in the vault, never here.
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=

# Last.fm ToS 4.3.4 caps cached Last.fm data at 100 MB. Alert below the cap so
# eviction has room to act before we are out of compliance.
LASTFM_CACHE_CAP_MB=80

# ListenBrainz has no application-level key at all: it is purely per-user
# tokens, supplied by each user at connect time and stored in the vault.

# iTunes, Deezer, ReccoBeats, and AcousticBrainz are keyless.

# --- HTTP ------------------------------------------------------------------
# Comma-separated exact origins. A wildcard is rejected outside local dev,
# because this API serves per-user data with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Serves 503 with Retry-After on every route except health checks.
MAINTENANCE_MODE=false
