# Environment for a local load run. Copy to load/.env.load and fill in.
#
# load/.env.load is gitignored. Nothing in this example file is a real
# credential and nothing here should ever become one: the KEK below is a
# placeholder that must be regenerated locally, and it exists only so a load
# stack can boot. See docs/RUNBOOK-SCALE.md.

DEPLOY_ENV=local
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=warn

# Database. Note the port.
#
# DATABASE_URL points at 5432 (Postgres directly) rather than 6432 (PgBouncer),
# because the BFF cannot currently connect through the local pooler at all: it
# passes statement_timeout as a connection parameter and PgBouncer answers
# `unsupported startup parameter: statement_timeout` unless
# IGNORE_STARTUP_PARAMETERS names it. Gate 1's pooler assertion therefore cannot
# be measured locally today. docs/RUNBOOK-SCALE.md carries the one-line fix.
DATABASE_URL=postgres://pullfm:pullfm_local_dev_not_a_secret@localhost:5432/pullfm
DATABASE_URL_DIRECT=postgres://pullfm:pullfm_local_dev_not_a_secret@localhost:5432/pullfm
DATABASE_POOL_MAX=10

# Cache Redis (allkeys-lru) and quota Redis (noeviction). Two instances is a
# security control, not a deployment accident: see docker-compose.dev.yml and
# load/scenarios/fail-closed.js.
REDIS_URL=redis://localhost:6379
REDIS_QUOTA_URL=redis://localhost:6380

# Generate your own and do not reuse it anywhere:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_KEKS=kek:v1=GENERATE_YOUR_OWN_32_BYTE_BASE64_KEY
CREDENTIAL_ACTIVE_KEK_ID=kek:v1

# WorkOS. The client id is a public identifier, not a secret. The API key is
# never used on any path a load run touches (auth goes through the local IdP),
# so a placeholder is correct here rather than lazy.
WORKOS_CLIENT_ID=client_01KYMZ05X60BJKZKY5RTA5YP8B
WORKOS_API_KEY=sk_test_placeholder_never_used_by_the_load_suite

MUSICBRAINZ_USER_AGENT="PullFM/0.1.0 (ope@312.dev)"
PUBLIC_BASE_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000
MAINTENANCE_MODE=false

# SeatGeek is off: /v1/artists/:mbid/events returns 501 without it, which is the
# documented behaviour and not something the load suite should paper over.
SEATGEEK_ENABLED=false

# Last.fm is left unconfigured on purpose. With no key, buildUpstream does not
# construct a Last.fm client at all, which removes one synchronous provider from
# the request path. Set it only when measuring the Last.fm cache governor.
# LASTFM_API_KEY=

# The global per-IP rate limiter is in-process (an LRU, not Redis) and keyed on
# req.ip, so an entire load run from one host shares ONE bucket. At the 300/min
# product default the run is capped at 5 req/s and measures the limiter instead
# of the system. Raised for load runs, and recorded in the run record.
RATE_LIMIT_MAX=1000000
RATE_LIMIT_WINDOW="1 minute"
