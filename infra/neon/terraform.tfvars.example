# ---------------------------------------------------------------------------
# Pull.fm - Neon variables (EXAMPLE)
#
# Copy to terraform.tfvars, which is gitignored.
#
# ---------------------------------------------------------------------------
# THIS FILE IS NOW MANDATORY, AND IT USED TO SAY THE OPPOSITE.
# ---------------------------------------------------------------------------
#
# WHAT IT USED TO SAY. "YOU NORMALLY DO NOT [need this]: every default in
# variables.tf was read back from the live project, so a plan with no tfvars at
# all is the correct plan."
#
# WHY THAT CHANGED. The four ADOPTION IDENTIFIERS at the bottom of this file have
# NO DEFAULTS, on purpose. They used to be string literals in imports.tf, and
# `tools/check-public-identifiers.mjs` has a detector for each shape: a Neon
# endpoint hostname is reachable from the internet with the credential as the only
# network control, and a branch id addresses a restorable copy of production data
# through the control plane. Eleven baseline findings came from that one file, and
# the baseline only shrinks, so the US cutover could not simply swap the literals.
#
# So `terraform plan` in this root now REQUIRES a terraform.tfvars. Without one it
# fails with "No value for required variable", which is a safe failure - it stops
# and names what is missing rather than planning the wrong thing. That is already
# true of backend.hcl, so a fresh checkout gains no new obstacle.
# `terraform init -backend=false && terraform validate` still needs nothing.
#
# THERE IS NO SECRET IN THIS FILE AND THERE MUST NEVER BE ONE. This repository
# is public and gitleaks blocks CI. The Neon API key is supplied as an
# environment variable read directly by the provider:
#
#   source infra/lib/credentials.sh && pullfm_load_credentials neon
#
# Note the asymmetry that follows: a project id is committed below, and branch and
# endpoint ids are not. That is not inconsistency. A project id is an opaque
# account-scoped handle that grants nothing and cannot be connected to; an
# endpoint id IS a public DNS name that accepts Postgres connections, and a branch
# id names a restorable copy of the data. The check draws the line in the same
# place.
# ---------------------------------------------------------------------------

# --- adoption --------------------------------------------------------------
# The project already exists and is imported, not created. Changing either of
# these points the configuration at a DIFFERENT project, which is never what
# you want; it is not how you rename anything. Repointed from the EU project to
# the US project on 2026-07-29, which took `terraform state rm` plus six import
# blocks and not an edit here; see imports.tf.
org_id     = "org-tiny-leaf-89756764"
project_id = "cold-brook-02833828"

# --- placement -------------------------------------------------------------
# UNITED STATES only, and immutable for an existing project: Neon cannot move a
# project between regions, which is why the cutover was a new project.
region_id  = "aws-us-east-1"
pg_version = 18

# --- point-in-time restore -------------------------------------------------
# 604800 seconds is 7 days, the live value on the US project (launch_v3). It was
# 21600 (6 hours, the free_v3 ceiling) on the EU project. MUST be set: the
# provider's own default is 86400, so omitting it plans a change - and leaving the
# old 21600 here would plan a REDUCTION of the restore window on production.
history_retention_seconds = 604800

# --- ADOPTION IDENTIFIERS. NO DEFAULTS. FILL THESE IN FROM THE CONTROL PLANE. --
#
# These four are the reason this file is mandatory. They are deliberately left
# EMPTY here rather than filled in with the live values: this file is tracked and
# the repository is public. Each carries a shape validation in variables.tf, so an
# empty or transposed value fails at variable-validation time with a message
# naming the API call, rather than as an unhelpful "resource not found" partway
# through an import.
#
# Read them, do not transcribe them. An id written down by hand is an id that can
# be stale, and this root has already been repointed from one project to another
# once:
#
#   source infra/lib/credentials.sh && pullfm_load_credentials neon
#   P=cold-brook-02833828
#
#   curl -sS -H "Authorization: Bearer $NEON_API_KEY" \
#     "https://console.neon.tech/api/v2/projects/$P/branches" |
#     python3 -c 'import json,sys; [print(("main_branch_id" if b["default"] else "staging_branch_id"), "=", repr(b["id"]), "#", b["name"]) for b in json.load(sys.stdin)["branches"]]'
#
#   curl -sS -H "Authorization: Bearer $NEON_API_KEY" \
#     "https://console.neon.tech/api/v2/projects/$P/endpoints" |
#     python3 -c 'import json,sys; [print(e["id"], e["branch_id"], e["type"]) for e in json.load(sys.stdin)["endpoints"]]'
#
# Match each endpoint to its branch by `branch_id`; there is exactly one
# `read_write` endpoint per branch. The `main_*` pair belongs to the branch with
# `default: true`.
main_branch_id      = "" # br-... , the branch with default: true
main_endpoint_id    = "" # ep-... , read_write on the default branch
staging_branch_id   = "" # br-... , the branch named "staging"
staging_endpoint_id = "" # ep-... , read_write on the staging branch

# --- branches --------------------------------------------------------------
staging_branch_name = "staging"

# Available on launch_v3, and still false. The reason is no longer the plan; see
# variables.tf.
default_branch_protected = false

# --- staging compute -------------------------------------------------------
# The live values, and they are the project's own default_endpoint_settings
# (0.25 to 8 CU, platform-default suspend) rather than a separate opinion.
#
# staging_max_cu WAS 1, which was free_v3 arithmetic against a 2 CU ceiling and a
# 100 CU-hour monthly allowance. Neither exists on launch_v3, and the mismatch
# against the live 8 made `terraform plan` report a change on EVERY run that
# nobody ever applied. Read the long block above `staging_max_cu` in variables.tf
# before lowering it: the MusicBrainz canonical load runs against this branch.
staging_min_cu                  = 0.25
staging_max_cu                  = 8
staging_suspend_timeout_seconds = 0

# --- roles -----------------------------------------------------------------
# Console-created names. Not cosmetic preferences: every field of the project's
# default-branch block is ForceNew, so these cannot be renamed in place.
owner_role_name = "neondb_owner"
database_name   = "neondb"

# The RUNTIME role the BFF authenticates as. Declared here, but NOT created by
# Terraform: a role created through the Neon API is a member of neon_superuser
# and that membership cannot be revoked by any role a Neon customer holds, so a
# Terraform-created role can never be least-privilege. It is created by
# infra/neon/sql/create-app-role.sql instead. See infra/neon/main.tf.
#
# `create_app_role` was removed rather than defaulted to false. It could only
# ever have chosen between no app role and an app role that was secretly an
# administrator.
app_role_name = "pullfm_app"

# --- network posture -------------------------------------------------------
# Requires a Scale plan. Populate with the app_egress_ipv4 output of the
# environment roots when the plan allows it; until then the credential is the
# only control on a publicly reachable endpoint.
allowed_ips = []

# --- consumption quota -----------------------------------------------------
#
# DELIBERATELY NOT SET HERE. `var.quota` carries a real default, sized to the
# USD 35 per month budget, and it is ARMED: 720000 compute-seconds (200 CU-hours,
# USD 21.20) and 520000000000 transfer bytes (520 GB), with the other three
# dimensions at 0 for unlimited. Overriding it in a gitignored file is how the
# spend cap ends up different on one machine than in the repository.
#
# EXCEEDING IT SUSPENDS EVERY ACTIVE COMPUTE IN THE PROJECT until the billing
# period rolls over, which on `main` means production is down. That outage risk
# was accepted by the owner in exchange for a hard bill ceiling.
#
# THE ONE TIME YOU DO SET IT HERE is to get out of a suspension before the period
# rolls over. Neon's documented recovery is to set the quota to zero, so nothing
# validates that the cap is non-zero:
#
#   quota = {
#     active_time_seconds  = 0
#     compute_time_seconds = 0
#     written_data_bytes   = 0
#     data_transfer_bytes  = 0
#     logical_size_bytes   = 0
#   }
#
# Apply that, confirm the computes start, then DELETE the block again so the cap
# comes back from the default. A repository whose spend cap is disarmed in an
# untracked file is a repository with no spend cap.
#
# Read the comment block above `variable "quota"` in variables.tf before changing
# any number: it carries the pricing, its URL, and the arithmetic from USD 35 to
# each value. In particular do NOT put a small number on `logical_size_bytes` -
# it is per branch and for the branch's lifetime, and the MusicBrainz loader
# legitimately peaks staging near 22 GB.
