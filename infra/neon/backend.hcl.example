# Copy to backend.hcl (gitignored) and fill in. Contains no secrets: the R2
# credentials are read from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in the
# environment, never from this file.
#
#   terraform init -backend-config=backend.hcl

bucket = "pull-fm-tfstate"
key    = "neon/terraform.tfstate"
region = "auto"

# THE `.eu.` FORM DOES NOT FIND THIS BUCKET. Verified 2026-07-29: an R2
# jurisdiction endpoint only lists buckets created in that jurisdiction, and
# `pull-fm-tfstate` is NOT in the EU jurisdiction, despite
# infra/terraform/README.md documenting `wrangler r2 bucket create
# pull-fm-tfstate --jurisdiction eu`. The EU endpoint returns only
# `pull-fm-backups-staging`, which is correctly EU-pinned.
#
# The live infra/terraform/envs/staging/backend.hcl already uses the non-EU form
# below, so this example has been disagreeing with the only working
# configuration in the repository.
#
# Left as a finding rather than fixed silently: the resolution is either to
# accept a non-EU state bucket (state holds infrastructure metadata and the
# database credential, not user personal data, so this is not the same GDPR
# question the backups bucket answers) or to recreate it with `--jurisdiction
# eu` and migrate the objects. Tracked in security/accepted-risks.md,
# PULLFM-RISK-008.
endpoints = {
  s3 = "https://REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com"
}

# Native state locking via a lockfile object. R2 has no DynamoDB analogue.
use_lockfile = true

# R2 is S3-compatible but is not AWS, so the AWS-specific preflight calls must
# all be skipped or init fails before it ever reaches the bucket.
skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_s3_checksum            = true
use_path_style              = true
