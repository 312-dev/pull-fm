# Copy to backend.hcl (gitignored) and fill in. Contains no secrets: the R2
# credentials are read from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in the
# environment, never from this file.
#
#   terraform init -backend-config=backend.hcl

bucket = "pull-fm-tfstate"
key    = "neon/terraform.tfstate"
region = "auto"

# NOTE THE ABSENCE OF `.eu.` HERE. It is deliberate and this example used to be
# wrong about it.
#
# An R2 jurisdiction endpoint only sees buckets created in that jurisdiction, so
# the two forms are not interchangeable: the wrong one fails at `terraform init`
# with a missing-bucket error rather than falling back. Verified 2026-07-29 by
# enumerating both endpoints with the state credential:
#
#   https://<account>.r2.cloudflarestorage.com      -> pull-fm-tfstate
#   https://<account>.eu.r2.cloudflarestorage.com   -> pull-fm-backups-staging
#
# So `pull-fm-tfstate` is NOT EU-pinned, even though infra/terraform/README.md
# documented creating it with `--jurisdiction eu`. Anybody following the runbook
# with the old `.eu.` value could not init.
#
# RE-ENUMERATED LATER THE SAME DAY, AFTER THE EU ESTATE WAS RETIRED. The `.eu.`
# endpoint now returns NOTHING: `pull-fm-backups-staging` and the two erasure
# ledgers were deleted. The observation above is kept as it was measured, because
# it is what proved the two endpoint forms are not interchangeable, and an empty
# EU endpoint proves nothing on its own - an endpoint with no buckets and an
# endpoint that cannot see the bucket you want look identical from here.
#
# THE US CUTOVER CHANGES WHICH HALF OF THAT IS A PROBLEM, NOT THE ENDPOINT VALUE
# HERE. The residency posture is now US-only, and the replacement data buckets
# (`pull-fm-backups-staging-us`, `pull-fm-ledger-staging-us`,
# `pull-fm-ledger-drill-us`) are DEFAULT jurisdiction with an ENAM location
# hint, because R2 has no `us` jurisdiction to pin to. Default jurisdiction
# means they answer on the same host this file already names, so the state
# bucket and the data buckets are on one endpoint again and the `.eu.` form is
# now the odd one out rather than the norm.
#
# PULLFM-RISK-010 ("pull-fm-tfstate is not in the EU jurisdiction the residency
# posture claims") is therefore retired by the posture changing rather than by
# the bucket moving. Re-read it in security/accepted-risks.md before assuming
# either way, and do not recreate this bucket casually: it holds live state.
endpoints = {
  s3 = "https://REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com"
}

# Native state locking via a lockfile object. R2 has no DynamoDB analogue.
use_lockfile = true

# R2 is S3-compatible but is not AWS, so the AWS-specific preflight calls must
# all be skipped or init fails before it ever reaches the bucket.
skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_s3_checksum            = true
use_path_style              = true
