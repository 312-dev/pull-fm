# ---------------------------------------------------------------------------
# Pull.fm - staging variables (EXAMPLE)
#
# Copy to terraform.tfvars, which is gitignored, and fill in the placeholders.
#
# THERE IS NO SECRET IN THIS FILE AND THERE MUST NEVER BE ONE. This repository
# is public and gitleaks blocks CI. Credentials are supplied as environment
# variables read directly by the providers:
#
#   source infra/lib/credentials.sh && pullfm_load_credentials staging
#
# That exports HCLOUD_TOKEN and a per-environment CLOUDFLARE_API_TOKEN. The
# account-wide Cloudflare global API key is bootstrap-only and the helper
# refuses to run when CLOUDFLARE_API_KEY or CLOUDFLARE_EMAIL are set.
#
# The two IDs below are public identifiers shown in the Cloudflare dashboard,
# not credentials, but they are still left as placeholders here so that a
# copy-paste of this file can never be mistaken for a working config.
# ---------------------------------------------------------------------------

cloudflare_account_id = "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID"
cloudflare_zone_id    = "REPLACE_WITH_PULL_FM_ZONE_ID"

# --- placement -------------------------------------------------------------
# EU only. fsn1 (Falkenstein) and hel1 (Helsinki) both carry CAX stock.
location = "fsn1"

network_ip_range = "10.20.0.0/16"
subnet_ip_range  = "10.20.1.0/24"

# --- sizing ----------------------------------------------------------------
# CAX is Ampere ARM64 and is preferred; the module also admits the legacy-priced
# cpx_1_ types because CAX has been out of stock across the EU sites. Hetzner
# raised CPX/CCX by 150-210 percent on 2026-06-15 while CAX rose about 30
# percent (docs/PLAN.md section 2).
#
# ONE NODE, REDIS ON IT, NO LOAD BALANCER. That is EUR 7.59/mo against EUR 42.26
# for the two-node shape this used to default to, and it is the right shape for
# an environment with no traffic. See docs/RUNBOOK-COST.md for the arithmetic.
#
# The two flags below are not preferences. app_node_count > 1 with either of
# them false is a PLAN-TIME ERROR: Redis holds the MusicBrainz token bucket and
# that limit is 1 req/s for the whole service, so a second node with its own
# local Redis emits 2 req/s and loses us the API. Scale out by setting all three
# together, never the count on its own.
app_node_count       = 1
enable_cache_node    = false
enable_load_balancer = false

# CHECK STOCK BEFORE COPYING THESE. Hetzner marks a type unavailable per
# LOCATION and only says so when the server is created, so an out-of-stock type
# passes `terraform plan` and fails `terraform apply`. Measured 2026-07-29 in
# hel1: cax11 and cx23 were orderable in no location at all, and cpx21 only in
# ash and hil, which are in the United States and therefore not an option while
# the database is a Neon branch in eu-central-1. cpx22 was the only 4 GB type in
# stock in the EU, at roughly twice the price. Whatever is in stock, 4 GB is a
# floor: 768 MB of BFF, 512 MB of Redis and a 384 MB job container do not fit in
# 2 GB.
#
#   curl -H "Authorization: Bearer $HCLOUD_TOKEN" \
#     https://api.hetzner.cloud/v1/datacenters | jq '.datacenters[]
#     | {loc: .location.name, available: .server_types.available}'
app_server_type   = "cpx22" # 2 vCPU x86 / 4 GB, and it now also runs Redis
cache_server_type = "cpx11" # only created when enable_cache_node = true

# --- durability ------------------------------------------------------------
# There is nothing durable on a Hetzner node any more. Postgres moved to Neon
# (infra/neon), which takes its own point-in-time backups, so the dedicated data
# volume and the whole-machine snapshot both went with it. What is left here is
# Redis: a cache that is meant to be lost and a counter set whose window is
# measured in minutes.
enable_cache_backups = false
enable_app_backups   = false

# --- access ----------------------------------------------------------------
# Public keys only. The matching private keys live in 1Password and never in
# this repository. SSH reaches these nodes over Tailscale; the firewall has no
# inbound rule for port 22.
ssh_public_keys = {
  operator = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIREPLACE_WITH_YOUR_PUBLIC_KEY operator@pull.fm"
}

# Optional. Prefer leaving this unset and enrolling nodes into the tailnet out
# of band: cloud-init is stored in Terraform state and stays readable from the
# Hetzner API. If it is set, use a single-use ephemeral key and treat it as
# burned after first boot. Supply it as TF_VAR_tailscale_auth_key, never here.
# tailscale_auth_key = null

# --- behaviour -------------------------------------------------------------
# The origin must be configured to parse PROXY protocol before this is true,
# or every connection through the load balancer fails.
enable_proxy_protocol = true

# Outbound allowlist on both firewalls. First thing to flip while debugging a
# suspected egress block, and the first thing to flip back.
restrict_egress = true

# --- naming ----------------------------------------------------------------
# Single label under the apex, deliberately, and NOT api.staging.pull.fm.
#
# Cloudflare's free Universal SSL certificate covers `pull.fm` and `*.pull.fm`
# and nothing deeper. A hostname two labels down has no edge certificate at
# all, so every TLS handshake to it fails before it reaches the origin, and the
# only fix Cloudflare sells is Advanced Certificate Manager at 10 USD/month per
# zone. That is about a third of this environment's entire budget, spent purely
# on the shape of a name. Production is unaffected: `api.pull.fm` is one label
# and Universal SSL already covers it.
#
# Switching to the dotted form is a two-line change here plus buying ACM, if
# the naming ever matters more than the money.
api_hostname       = "api-staging.pull.fm"
app_hostname       = "app-staging.pull.fm"
backup_bucket_name = "pull-fm-backups-staging"
