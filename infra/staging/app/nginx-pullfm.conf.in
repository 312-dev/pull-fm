# ---------------------------------------------------------------------------
# Pull.fm staging origin - TLS termination and Cloudflare enforcement.
#
# THIS FILE IS A TEMPLATE, NOT A CONFIG. bootstrap.sh renders @PROXY@ and
# installs the result as /etc/nginx/sites-available/pullfm. It is `.in` rather
# than `.conf` so that nobody copies it into place by hand and gets an nginx
# that will not start.
#
# There are two supported traffic paths and the rendered file must match the one
# Terraform provisioned. This is the single most dangerous coupling in the
# repository, because getting it wrong produces a 400 on EVERY connection, which
# reads as an application bug rather than a listener misconfiguration:
#
#   direct         client -> Cloudflare edge -> this nginx :443 -> BFF :3000
#   (PULLFM_INGRESS=direct, the default, and what enable_load_balancer = false
#   provisions). @PROXY@ renders EMPTY. The Cloudflare edge is the L3 peer, so
#   $remote_addr is already the address the allowlist needs to check.
#
#   load-balancer  client -> Cloudflare edge -> Hetzner LB (TCP passthrough,
#   PROXY protocol) -> this nginx :443 -> BFF :3000
#   (PULLFM_INGRESS=lb, what enable_load_balancer = true provisions). @PROXY@
#   renders as `proxy_protocol`, and bootstrap.sh additionally writes the realip
#   directives into conf.d so $remote_addr is rewritten from the PROXY header
#   to the Cloudflare edge address. The allowlist then reads the same variable
#   in both modes, which is why there is only one template and not two configs
#   drifting apart.
#
# Four things here are load-bearing and none of them are obvious:
#
#   1. @PROXY@ must agree with the load balancer. On the LB path the listener
#      MUST parse the PROXY header; on the direct path it MUST NOT. See above.
#
#   2. WHICH LAYER ENFORCES "ONLY CLOUDFLARE" DEPENDS ON THE PATH. On the LB
#      path the Hetzner firewall does not protect it at all: LB traffic arrives
#      on the PRIVATE interface and Hetzner Cloud Firewalls filter the public
#      one, so the allowlist below is the only enforcement. On the direct path
#      the traffic does arrive on the public interface, so the firewall rule
#      finally covers the path it was written for and the allowlist becomes a
#      second, independent layer rather than the only one.
#
#   3. THE CLIENT IP DOES NOT COME FROM THE PROXY HEADER, on either path. The
#      PROXY header carries the CLOUDFLARE EDGE address, because Cloudflare is
#      the only peer the load balancer ever sees. The real client address comes
#      from CF-Connecting-IP and is forwarded below. That is why removing the
#      load balancer does not change one value in audit_log.ip or one decision
#      in the per-IP rate limiter.
#
#   4. Authenticated Origin Pulls uses a CA shared by every Cloudflare
#      customer, so `ssl_verify_client on` alone proves only that the peer is
#      *someone's* Cloudflare. The subject check closes that gap.
# ---------------------------------------------------------------------------

upstream pullfm_bff {
    server 127.0.0.1:3000;
    keepalive 32;
}

# The realip directives that belong to the load-balancer path are NOT here. They
# are written to /etc/nginx/conf.d/00-pullfm-ingress.conf by bootstrap.sh, in
# the same step that chooses @PROXY@, so the two halves of the decision cannot
# be edited apart. conf.d is included before sites-enabled, so they still apply.

# --- Port 80: redirect only ------------------------------------------------
server {
    listen 80 @PROXY@ default_server;
    listen [::]:80 @PROXY@ default_server;
    server_name _;

    # Kept on plain HTTP so the load balancer's health check cannot be broken
    # by a certificate problem: a cert failure should show as a TLS error, not
    # as every node being marked down.
    location = /healthz {
        access_log off;
        proxy_pass http://pullfm_bff;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- Health check listener, never PROXY protocol ---------------------------
# The load balancer health check is a separate connection from the service
# traffic, and whether it carries a PROXY header is a vendor behaviour rather
# than something we configure. This listener exists so the health check works
# under either answer: point health_check_port at 8080 if it does not. It is
# never rendered with @PROXY@ for that reason.
#
# Unused on the direct path, where there is no load balancer to health check.
# Kept anyway: it is not publicly reachable (the origin firewall allows inbound
# 80 and 443 only), and deleting it would make turning the load balancer back on
# a two-file change instead of one variable.
server {
    listen 8080 default_server;
    server_name _;

    location = /healthz {
        access_log off;
        proxy_pass http://pullfm_bff;
    }

    location / {
        return 404;
    }
}

# --- Port 443: the real origin ---------------------------------------------
server {
    # `http2 on;` is nginx >= 1.25 syntax and Ubuntu 24.04 ships 1.24, where it
    # is an unknown directive and nginx refuses to start. The listen-parameter
    # form works on both.
    listen 443 ssl http2 @PROXY@ default_server;
    listen [::]:443 ssl http2 @PROXY@ default_server;
    server_name api-staging.pull.fm app-staging.pull.fm;

    ssl_certificate     /etc/ssl/pullfm/origin.pem;
    ssl_certificate_key /etc/ssl/pullfm/origin.key;

    # Authenticated Origin Pulls. Cloudflare presents a client certificate
    # issued by this CA; anything that reaches port 443 without one is refused
    # during the handshake.
    ssl_client_certificate /etc/ssl/pullfm/origin-pull-ca.pem;
    ssl_verify_client on;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache shared:pullfm:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # The origin certificate is issued by Cloudflare's private Origin CA, which
    # no public trust store contains and no public OCSP responder answers for.
    # Stapling would fail on every handshake and log an error per request.
    ssl_stapling off;

    server_tokens off;

    # $cloudflare_edge is defined in conf.d/cloudflare-allowlist.conf, which is
    # regenerated from Cloudflare's published ranges by pullfm-cf-ranges.timer.
    # It keys on $remote_addr, which is the Cloudflare edge address on BOTH
    # paths: directly on the direct path, and after the realip rewrite on the
    # load-balancer path.
    if ($cloudflare_edge = 0) {
        return 403;
    }

    # Shared-CA gap: every Cloudflare customer's origin-pull certificate
    # validates against the same CA, so the issuer proves the peer is
    # Cloudflare but not that it is fronting *our* zone. The subject is the
    # only distinguishing field available at this layer.
    if ($ssl_client_s_dn !~ "CN=origin-pull.cloudflare.net") {
        return 403;
    }

    client_max_body_size 256k;

    location / {
        proxy_pass http://pullfm_bff;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host $host;
        # CF-Connecting-IP is trustworthy here precisely because the two checks
        # above already proved the peer is a Cloudflare edge node holding a
        # valid origin-pull certificate. Forwarding it as X-Forwarded-For is
        # what makes the BFF's per-IP rate limiting operate on the real client
        # rather than on a handful of edge addresses.
        proxy_set_header X-Forwarded-For $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $http_cf_connecting_ip;

        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }
}
