#!/usr/bin/env bash
# Regenerates the nginx Cloudflare edge allowlist from Cloudflare's published
# ranges.
#
# This is the enforcement point for "only Cloudflare may reach the origin" on
# the load-balanced path, because Hetzner Cloud Firewalls filter the public
# interface only and load balancer traffic arrives on the private one. A stale
# list therefore fails in the worst possible direction: a newly published
# Cloudflare range becomes a 403 for real users.
#
# nginx is reloaded only when the generated file actually changes, so running
# this on a timer costs nothing on the common path.
set -euo pipefail

OUT=/etc/nginx/conf.d/cloudflare-allowlist.conf
TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT

V4=$(curl -fsS --max-time 20 https://www.cloudflare.com/ips-v4)
V6=$(curl -fsS --max-time 20 https://www.cloudflare.com/ips-v6)

# A truncated or empty answer must not be allowed to lock everyone out. Twenty
# is comfortably below the roughly two dozen ranges Cloudflare publishes and
# comfortably above anything a partial response would yield.
COUNT=$(printf '%s\n%s\n' "$V4" "$V6" | grep -c '/' || true)
if [ "$COUNT" -lt 20 ]; then
  echo "refusing to write an allowlist of only $COUNT ranges" >&2
  exit 1
fi

{
  echo "# Generated by pullfm-cf-ranges on $(date -u +%FT%TZ). Do not edit."
  echo "geo \$proxy_protocol_addr \$cloudflare_edge {"
  echo "    default 0;"
  printf '%s\n%s\n' "$V4" "$V6" | grep '/' | sed 's/^/    /; s/$/ 1;/'
  echo "}"
} >"$TMP"

if [ -f "$OUT" ] && diff -q <(tail -n +2 "$TMP") <(tail -n +2 "$OUT") >/dev/null; then
  echo "cloudflare allowlist unchanged ($COUNT ranges)"
  exit 0
fi

install -m 0644 "$TMP" "$OUT"
nginx -t
systemctl reload nginx
echo "cloudflare allowlist updated ($COUNT ranges)"
