[Unit]
Description=Anonymize and expire the audit trail
Documentation=https://github.com/312-dev/pull-fm/blob/main/docs/RUNBOOK-JOBS.md
After=docker.service network-online.target
Requires=docker.service
ConditionPathExists=/etc/pullfm/deploy.env

OnFailure=pullfm-job-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/pullfm-job purge-audit

# Exit 2 covers four things, none urgent on its own: a statement failed, a batch
# ceiling was hit, the standing invariant of data-retention-policy.md 8.5 is
# still violated, or the freshness signal fired. Exit 1 means the purge could not
# run at all, so audit_log is once again an unbounded store of account
# identifiers and IP addresses, which is the exact condition the job exists to
# end and the one blocking publication of legal/privacy-policy.md.
SuccessExitStatus=2

TimeoutStartSec=1800

# systemd IGNORES BOTH OF THE DIRECTIVES THAT USED TO BE HERE, and it says so
# on every daemon-reload, where nobody was reading:
#
#   Unknown key name 'OnFailure' in section 'Service', ignoring.
#   RuntimeMaxSec= has no effect in combination with Type=oneshot. Ignoring.
#
# OnFailure= is a [Unit] directive. Sitting in [Service] it parsed, logged, and
# did nothing, so every one of these jobs was running with NO alert path at all
# - the failure mode the whole exit-code contract exists to make visible. It is
# now in [Unit] above.
#
# RuntimeMaxSec= bounds a service that has REACHED the running state, and a
# Type=oneshot service never does: it is in "activating" from ExecStart until
# ExecStart returns. The directive that bounds that window is TimeoutStartSec=,
# which is what pullfm-deploy.service already used correctly. A wedged job was
# therefore unbounded.
