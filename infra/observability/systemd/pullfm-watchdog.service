[Unit]
Description=Turn Pull.fm metric conditions into notifications
Documentation=https://github.com/312-dev/pull-fm/blob/main/docs/RUNBOOK-INCIDENT.md
After=network-online.target

# The watchdog is useless before the application exists and harmless after it
# stops, so it is not Requires= or BindsTo= on anything: a node with no
# container should still run it, notice /healthz is not answering, and say so.

[Service]
Type=oneshot
EnvironmentFile=-/etc/pullfm/alert.env
ExecStart=/usr/local/bin/pullfm-watchdog

# NOT SuccessExitStatus= and NOT OnFailure=, unlike the four job units, and the
# asymmetry is deliberate. Those four exist to enforce retention windows, so a
# unit that could not run is itself an alertable condition. This one exists to
# SEND alerts, so wiring its failure into the alert path would mean a channel
# outage tries to report itself through the channel that is out. It exits 0
# unconditionally and a watchdog that stopped watching shows up as a stale
# `last elapse` in `systemctl list-timers`, plus the absence of the heartbeat
# line in the journal.

# TimeoutStartSec=, NOT RuntimeMaxSec=, and this unit had the wrong one until
# 2026-07-29 - the same defect that was fixed in the four job units under
# infra/staging/app/systemd and left here. systemd says so on every
# daemon-reload, where nobody was reading:
#
#   RuntimeMaxSec= has no effect in combination with Type=oneshot. Ignoring.
#
# RuntimeMaxSec= bounds a service that has REACHED the running state. A
# Type=oneshot service never does: it sits in "activating" from ExecStart until
# ExecStart returns, so the directive matched nothing and the watchdog was
# UNBOUNDED. TimeoutStartSec= is the one that bounds that window.
#
# It matters more here than on the job units, because this unit is what notices
# that anything else is wrong. The timer fires OnUnitActiveSec=1min and systemd
# will not start a second copy of a oneshot that is still activating, so a
# watchdog wedged on a hung /metrics read did not just miss one minute: it
# suppressed every subsequent run forever, silently, while `systemctl
# list-timers` showed the timer as armed. 50 seconds keeps a full run strictly
# inside the minute, so a wedged scrape is killed and the next minute is
# watched.
TimeoutStartSec=50

# It reads /metrics over loopback and writes two small state files. Nothing
# else, so nothing else is permitted.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pullfm /var/log/pullfm
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
