#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# Pull.fm alert sender. THE notification channel, and the only one.
#
#   pullfm-alert --key <dedupe-key> --title <title> [options] [--message <text>]
#
# Everything that wants to tell the operator something goes through this file,
# so there is exactly one place that knows what the channel is, one place that
# knows how to authenticate to it, and one place to change when it moves.
#
# ---------------------------------------------------------------------------
# WHY THE CHANNEL IS NOT IN THIS FILE
#
# The endpoint arrives at runtime from /etc/pullfm/alert.env, written by
# infra/observability/install-alert-env.sh out of 1Password, and never touches
# git. For most providers the URL IS the credential - a Discord or Slack webhook
# URL is a bearer token with a hostname in front of it, and on an anonymous ntfy
# the topic name is the whole access control - so it is handled as a secret
# whatever is configured.
#
# The TRANSPORT is no longer hardcoded either. PULLFM_ALERT_SINK_KIND selects the
# wire format, so moving Pull.fm's alerting to a different provider is one
# 1Password value and no code change. See DECISIONS.md SD-003.
#
# ---------------------------------------------------------------------------
# THE PRIMARY PATH IS NOT IN THIS FILE AT ALL, AND THAT IS THE POINT
#
# This file PUSHES. A push from the node cannot report the node being gone, and
# for most of this project's life that was the only path, which meant silence and
# health were indistinguishable. The primary path is now a PULL: pullfm-heartbeat
# writes a content-free beat, nginx serves it, and a scheduled GitHub Actions
# workflow outside every machine we own reads it and raises an issue when it
# stops. Nothing on this node can suppress that.
#
# So this file is now the LOW-LATENCY path, not the reliable one, and the
# division of labour is deliberate: it tells the operator quickly when it can,
# and the external watcher tells them eventually whatever happens here.
#
# ---------------------------------------------------------------------------
# THE FIVE SURFACES, IN ORDER OF HOW MUCH CONFIGURATION THEY NEED
#
#   1. The journal, at error priority, tagged `pullfm-alert`, always. Costs
#      nothing and exists on any node.
#   2. The spool, /var/log/pullfm/alerts.jsonl, always. One JSON object per
#      alert including whether delivery worked, so "nobody was told" is itself
#      a recorded fact rather than an absence of one.
#   3. The dedupe stamp in /var/lib/pullfm/alerts/, always - which is what
#      pullfm-heartbeat counts, so EVERY alert reaches the external watcher even
#      with no sink configured at all. This is why an unconfigured sink is no
#      longer the same thing as an unreachable operator.
#   4. The push sink, when alert.env configures one.
#   5. The caller's exit code, so a watchdog can tell a delivered alert from an
#      undelivered one and does not have to guess.
#
# ---------------------------------------------------------------------------
# DEDUPLICATION IS NOT A NICETY HERE
#
# The watchdog runs every minute. A condition that stays true for a day is 1440
# notifications, and an operator who mutes the topic has exactly the same
# coverage as an operator who never armed it. Every alert therefore carries a
# --key, and a key that fired inside PULLFM_ALERT_REPEAT_S (default 3600) is
# suppressed, with the suppression recorded in the spool so the record stays
# complete. --resolve clears the key and sends one recovery notice, so a
# condition that fixes itself says so rather than going quiet in a way that is
# indistinguishable from the alerter dying.
#
# EXIT CODES
#   0  delivered to the push sink
#   3  no push sink configured. The journal, the spool and the dedupe stamp were
#      still written, so the external watcher WILL see this within one of its
#      intervals. 3 means "not pushed", not "nobody will ever know", and the
#      difference matters now that a second path exists.
#   4  a push sink is configured and delivery FAILED
#   5  suppressed as a duplicate inside the repeat window
#
# Never non-zero for a bad argument once the message exists: an alerter that
# refuses to alert because of its own argument handling is the failure mode this
# whole file exists to avoid.
# ---------------------------------------------------------------------------
set -uo pipefail

ALERT_ENV=${PULLFM_ALERT_ENV:-/etc/pullfm/alert.env}
SPOOL_DIR=${PULLFM_ALERT_SPOOL_DIR:-/var/log/pullfm}
STATE_DIR=${PULLFM_ALERT_STATE_DIR:-/var/lib/pullfm/alerts}
SPOOL=${SPOOL_DIR}/alerts.jsonl

KEY=""
TITLE=""
MESSAGE=""
PRIORITY=high
TAGS=rotating_light
RUNBOOK=""
RESOLVE=false

while [ $# -gt 0 ]; do
  case "$1" in
    --key) KEY=${2:-}; shift 2 ;;
    --title) TITLE=${2:-}; shift 2 ;;
    --message) MESSAGE=${2:-}; shift 2 ;;
    --priority) PRIORITY=${2:-high}; shift 2 ;;
    --tags) TAGS=${2:-rotating_light}; shift 2 ;;
    --runbook) RUNBOOK=${2:-}; shift 2 ;;
    --resolve) RESOLVE=true; shift ;;
    --) shift; break ;;
    *) shift ;;
  esac
done

[ -n "${TITLE}" ] || TITLE="Pull.fm alert"
[ -n "${KEY}" ] || KEY=$(printf '%s' "${TITLE}" | tr -c 'a-zA-Z0-9' '_')
# Only the characters that are safe in a filename. The key reaches the
# filesystem, so it is sanitised rather than trusted.
SAFE_KEY=$(printf '%s' "${KEY}" | tr -c 'a-zA-Z0-9._-' '_' | cut -c1-96)

# stdin is accepted so a caller can pipe a long body without quoting it.
if [ -z "${MESSAGE}" ] && [ ! -t 0 ]; then
  MESSAGE=$(cat 2>/dev/null || true)
fi
[ -n "${MESSAGE}" ] || MESSAGE="(no detail)"

WHEN=$(date -u +%Y-%m-%dT%H:%M:%SZ)
NOW=$(date -u +%s)
HOST=$(hostname 2>/dev/null || echo unknown)

if [ -f "${ALERT_ENV}" ]; then
  # shellcheck disable=SC1090
  . "${ALERT_ENV}" 2>/dev/null || true
fi

REPEAT_S=${PULLFM_ALERT_REPEAT_S:-3600}
ENVLABEL=${PULLFM_ALERT_ENV_LABEL:-unknown}
STATE_FILE="${STATE_DIR}/${SAFE_KEY}"

mkdir -p "${STATE_DIR}" 2>/dev/null || true
mkdir -p "${SPOOL_DIR}" 2>/dev/null || true

# --- spool writer, used on every path -------------------------------------
# Values are JSON-escaped through the same helper so a journal tail containing a
# quote cannot produce a spool line that no parser will read. A spool nothing
# can parse is a spool that does not exist.
esc() {
  printf '%s' "${1:-}" | python3 -c 'import json,sys; sys.stdout.write(json.dumps(sys.stdin.read())[1:-1])' 2>/dev/null ||
    printf '%s' "${1:-}" | tr -d '"\\' | tr '\n\r\t' '   '
}

spool() {
  printf '{"ts":"%s","host":"%s","env":"%s","key":"%s","title":"%s","priority":"%s","resolve":%s,"delivered":%s,"delivery":"%s"}\n' \
    "${WHEN}" "$(esc "${HOST}")" "$(esc "${ENVLABEL}")" "$(esc "${KEY}")" \
    "$(esc "${TITLE}")" "${PRIORITY}" "${RESOLVE}" "${1}" "${2}" \
    >>"${SPOOL}" 2>/dev/null || true
  chmod 0640 "${SPOOL}" 2>/dev/null || true
}

# --- resolve path ----------------------------------------------------------
if [ "${RESOLVE}" = true ]; then
  # Nothing was firing, so there is nothing to recover from and no notice is
  # owed. Staying silent here is what keeps the channel worth reading.
  [ -f "${STATE_FILE}" ] || exit 0
  rm -f "${STATE_FILE}" 2>/dev/null || true
  PRIORITY=default
  TAGS=white_check_mark
  TITLE="RESOLVED: ${TITLE}"
else
  # --- dedupe ---------------------------------------------------------------
  if [ -f "${STATE_FILE}" ]; then
    LAST=$(cat "${STATE_FILE}" 2>/dev/null || echo 0)
    case "${LAST}" in ''|*[!0-9]*) LAST=0 ;; esac
    if [ $((NOW - LAST)) -lt "${REPEAT_S}" ]; then
      echo "PULLFM-ALERT suppressed key=${KEY} (last sent $((NOW - LAST))s ago, repeat ${REPEAT_S}s)" >&2
      spool false suppressed-duplicate
      exit 5
    fi
  fi
fi

# --- 1. the journal --------------------------------------------------------
{
  echo "PULLFM-ALERT env=${ENVLABEL} host=${HOST} key=${KEY} priority=${PRIORITY}"
  echo "${TITLE}"
  echo "${MESSAGE}"
  [ -n "${RUNBOOK}" ] && echo "runbook: ${RUNBOOK}"
} >&2

# --- 3. delivery -----------------------------------------------------------
DELIVERED=false
DELIVERY=none-configured

# PULLFM_NTFY_URL is still honoured so a node whose alert.env predates the
# provider-agnostic rename keeps pushing rather than silently stopping. A
# compatibility fallback that is written down is maintenance; one that is not is
# a trap.
SINK_URL=${PULLFM_ALERT_SINK_URL:-${PULLFM_NTFY_URL:-}}
SINK_TOKEN=${PULLFM_ALERT_SINK_TOKEN:-${PULLFM_NTFY_TOKEN:-}}
SINK_KIND=${PULLFM_ALERT_SINK_KIND:-}
[ -n "${SINK_KIND}" ] || SINK_KIND=ntfy

if [ -n "${SINK_URL}" ]; then
  DELIVERY=attempted

  BODY="${MESSAGE}"
  [ -n "${RUNBOOK}" ] && BODY="${BODY}

runbook: ${RUNBOOK}"
  BODY="${BODY}

env=${ENVLABEL} host=${HOST} key=${KEY} at=${WHEN}"

  # An array, not `${VAR:+-H "..."}`. The inline form looks like it works and
  # does not: an unquoted expansion word-splits on the spaces inside the header
  # value, so curl receives four broken arguments instead of two.
  args=()
  case "${SINK_KIND}" in
    ntfy)
      args=(-H "Title: ${TITLE}" -H "Priority: ${PRIORITY}" -H "Tags: ${TAGS}")
      [ -n "${RUNBOOK}" ] && args+=(-H "Actions: view, Runbook, ${RUNBOOK}")
      [ -n "${SINK_TOKEN}" ] && args+=(-H "Authorization: Bearer ${SINK_TOKEN}")
      PAYLOAD="${BODY}"
      ;;
    discord | slack | webhook)
      # One JSON body that all three accept. Discord reads `content`, Slack reads
      # `text`, and a generic receiver gets both plus the structured fields. Three
      # nearly identical payload builders would be three places for the escaping
      # to go wrong, and the escaping is the only hard part.
      esc_title=$(esc "${TITLE}")
      esc_body=$(esc "${BODY}")
      PAYLOAD=$(printf '{"content":"**%s**\\n%s","text":"*%s*\\n%s","username":"pullfm-%s","pullfm":{"key":"%s","priority":"%s","env":"%s","host":"%s","resolved":%s}}' \
        "${esc_title}" "${esc_body}" "${esc_title}" "${esc_body}" \
        "$(esc "${ENVLABEL}")" "$(esc "${KEY}")" "${PRIORITY}" \
        "$(esc "${ENVLABEL}")" "$(esc "${HOST}")" "${RESOLVE}")
      args=(-H 'Content-Type: application/json')
      # A bearer header is added only when a token exists. Discord and Slack
      # authenticate by the secret INSIDE the URL and reject an extra
      # Authorization header on some paths, which is why it is conditional rather
      # than always present.
      [ -n "${SINK_TOKEN}" ] && args+=(-H "Authorization: Bearer ${SINK_TOKEN}")
      ;;
    *)
      DELIVERY=unknown-sink-kind
      echo "PULLFM-ALERT sink kind '${SINK_KIND}' is not supported by this version." >&2
      SINK_URL=""
      ;;
  esac

  # --max-time 10 twice over: an alerter that blocks is a watchdog that stops
  # watching. Two attempts, because a single dropped SYN should not be the
  # difference between told and not told, and no more than two because the spool
  # and the heartbeat are already the durable record.
  if [ -n "${SINK_URL}" ]; then
    for attempt in 1 2; do
      if printf '%s' "${PAYLOAD}" | curl -fsS --max-time 10 \
        "${args[@]+"${args[@]}"}" \
        --data-binary @- \
        "${SINK_URL}" >/dev/null 2>&1; then
        DELIVERED=true
        DELIVERY="${SINK_KIND}"
        break
      fi
      [ "${attempt}" = 1 ] && sleep 2
    done

    [ "${DELIVERED}" = true ] || {
      DELIVERY="${SINK_KIND}-failed"
      echo "PULLFM-ALERT push to the ${SINK_KIND} sink FAILED. The journal, ${SPOOL} and the" >&2
      echo "heartbeat are the record, and the external watcher will still see this alert." >&2
    }
  fi
fi

# --- 2. the spool ----------------------------------------------------------
# Written after the attempt so `delivered` is a fact rather than an intention.
spool "${DELIVERED}" "${DELIVERY}"

# The dedupe stamp is only set for a firing alert, and only once the attempt is
# over. Setting it earlier would let a delivery failure consume the whole repeat
# window, so a transient network fault would silence a real condition for an
# hour.
if [ "${RESOLVE}" != true ]; then
  printf '%s' "${NOW}" >"${STATE_FILE}" 2>/dev/null || true
fi

# --- refresh the heartbeat so the external watcher sees this within its next
#     interval rather than within the heartbeat timer's -----------------------
#
# The stamp above is what pullfm-heartbeat counts, so the alert would reach the
# watcher anyway at the next five-minute beat. Refreshing here removes up to five
# minutes of avoidable latency on the path that always works, and it is the
# cheapest thing in this file.
#
# Guarded and ignored on failure ON PURPOSE. An alerter that fails because its
# heartbeat emitter is missing is an alerter that stops alerting over a
# non-essential optimisation, and the timer will emit the beat regardless.
if command -v pullfm-heartbeat >/dev/null 2>&1; then
  pullfm-heartbeat >/dev/null 2>&1 || true
fi

[ "${DELIVERED}" = true ] && exit 0
[ "${DELIVERY}" = none-configured ] && exit 3
exit 4
