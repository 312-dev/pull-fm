# ---------------------------------------------------------------------------
# /etc/pullfm/alert.env  -  root:root 0600, NEVER in git.
#
# Written by infra/observability/install-alert-env.sh, which resolves the values
# from 1Password at converge time. This file is the SHAPE, with op:// references
# where the values go. It contains no values and never will.
#
# DO NOT HAND-EDIT THE REAL FILE ON A NODE. The next converge overwrites it, so a
# hand edit is a change that disappears on the next deploy and takes whatever it
# configured with it.
# ---------------------------------------------------------------------------

# Appears in every alert and in the heartbeat. Set it, or a staging page at 3am
# is indistinguishable from a production one.
PULLFM_ALERT_ENV_LABEL=staging

# Seconds before the SAME alert key may fire again. The watchdog runs every
# minute; without this a condition that stays true for a day is 1440
# notifications and the operator mutes the channel, which is the same coverage as
# never arming it.
PULLFM_ALERT_REPEAT_S=3600

# ---------------------------------------------------------------------------
# THE PRIMARY PATH: a pull, with no credential anywhere in it
#
# pullfm-heartbeat writes a content-free beat here every five minutes and after
# every alert. nginx serves it at the URL below. A scheduled workflow in
# 312-dev/pullfm-heartbeat reads it from outside all of our infrastructure and
# raises a GitHub issue when it is absent, stale, malformed, or reports
# unacknowledged conditions.
#
# NEITHER OF THESE IS A SECRET, and that is the design rather than an oversight.
# The beat carries a timestamp, a count, and dedupe keys that are already public
# in pullfm-watchdog. It carries no hostname, no unit path and no journal tail,
# because it is served to the public internet. A credential here would have to
# live in a public repository's Actions secrets, and a watcher that breaks when a
# secret rotates breaks silently.
#
# Both have working defaults in the installer, because a control that has to be
# remembered is a control that disappears at the next rebuild - see
# PULLFM-RISK-012, which was exactly that.
# ---------------------------------------------------------------------------
PULLFM_HEARTBEAT_FILE=/var/lib/pullfm/heartbeat/staging.json
PULLFM_HEARTBEAT_URL=https://api-staging.pull.fm/.well-known/pullfm-heartbeat

# ---------------------------------------------------------------------------
# THE SECONDARY PATH: an optional immediate push
#
# Optional because it is no longer the only path. An empty sink means alerts
# still reach the operator through the heartbeat; the cost is latency (one
# watcher interval) and not coverage. Exit code 3 from pullfm-alert means "not
# pushed", NOT "nobody will ever know".
#
# THE DESTINATION IS ONE VALUE. Point ALERT_SINK_URL at Grafana OnCall, Pushover,
# a Discord or Slack webhook, or a hosted ntfy, and nothing in the repository
# changes: pullfm-alert derives the wire format from the URL.
#
# TREAT THE URL AS A SECRET whatever provider it names. A Discord or Slack webhook
# URL is a bearer token with a hostname in front of it, and on an anonymous ntfy
# the topic name is the whole access control. install-alert-env.sh never echoes
# the resolved value and --check prints the host with the path stripped.
#
#   op://MCP/pull-fm/staging/ALERT_SINK_URL
#   op://MCP/pull-fm/staging/ALERT_SINK_TOKEN
#
# ALERT_SINK_KIND is DERIVED from the URL, not stored beside it: a second field is
# a second thing to get wrong, and every provider's URL identifies it already.
# One of: none, ntfy, discord, slack, webhook.
#
# If a token is ever set that also grants publish on topics belonging to something
# other than Pull.fm, read README.md section 2 first. That is the specific mistake
# this file is laid out to prevent, and it has been made once already.
# ---------------------------------------------------------------------------
PULLFM_ALERT_SINK_KIND=none
PULLFM_ALERT_SINK_URL=
PULLFM_ALERT_SINK_TOKEN=

# Compatibility only, and emitted by the installer ONLY when the sink kind is
# ntfy. infra/staging/app/pullfm-job-alert reads these names directly instead of
# going through pullfm-alert, so an ntfy-shaped sink keeps that path working with
# no edit to a file infra/observability does not own. A Discord webhook exported
# under these names would make that script POST an ntfy-shaped request to an
# endpoint that rejects it, and a silent 400 is worse than an obviously
# unconfigured leg.
#
#   PULLFM_NTFY_URL=
#   PULLFM_NTFY_TOKEN=
